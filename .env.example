# Database (local dev database is named "carescreen")
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/carescreen?schema=public"

# Session signing secret (any long random string)
SESSION_SECRET="change-me-to-a-long-random-string"

# quickAuth OAuth (https://github.com/nmallik1029/quickAuth)
# Register ClinicScreen as a client app in your quickAuth instance to get these.
QUICKAUTH_URL="http://localhost:3000"
QUICKAUTH_CLIENT_ID="qa_client_xxxxxxxx"
QUICKAUTH_CLIENT_SECRET="qa_secret_xxxxxxxx"
QUICKAUTH_REDIRECT_URI="http://localhost:3001/auth/callback"
QUICKAUTH_PROVISION_SECRET="same-as-quickauth-PROVISION_SECRET"

# Media storage. Leave R2_* blank for local-disk uploads (dev). Set all five to
# store/serve media from Cloudflare R2 (required for container/serverless hosting).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""
