{
  "appId": "com.clinicscreen.player",
  "productName": "ClinicScreen Player",
  "icon": "icon.png",
  "directories": {
    "output": "dist-player",
    "buildResources": "assets"
  },
  "files": [
    "main.js",
    "preload.js",
    "shared.js",
    "player.js",
    "loading.html",
    "splash.html"
  ],
  "extraMetadata": {
    "description": "ClinicScreen Player",
    "csTarget": "player"
  },
  "extraResources": [
    {
      "from": "assets/icon.png",
      "to": "icon.png"
    }
  ],
  "win": {
    "icon": "icon.png",
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "ClinicScreen Player"
  }
}
