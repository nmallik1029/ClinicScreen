[Unit]
Description=ClinicScreen Kiosk (Chromium fullscreen)
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
# Don't fight the login prompt for the screen's TTY.
Conflicts=getty@tty1.service

[Service]
Type=simple
User=__KIOSK_USER__
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=HOME=/home/__KIOSK_USER__
WorkingDirectory=/home/__KIOSK_USER__
# startx launches a bare X server on vt1 and runs our session script inside it.
ExecStart=/usr/bin/startx /usr/local/bin/clinicscreen-kiosk-session -- vt1 -keeptty -nolisten tcp
# If Chromium or X ever dies, bring the screen straight back.
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
