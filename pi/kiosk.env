# ClinicScreen kiosk configuration.
# Installed to /etc/clinicscreen/kiosk.env on the Pi.

# The deployed app the screen points at. Change this for staging/local testing.
CLINICSCREEN_URL=https://clinicscreen-app.nmallik1029.workers.dev

# The single stable page the kiosk opens. /enroll self-heals:
#  - already paired  -> jumps to /player/<id>?t=<token>
#  - not paired      -> shows the pairing code
#  - token reset     -> Repair clears it and returns here
KIOSK_PATH=/enroll
