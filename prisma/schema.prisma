generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  OFFICE_ADMIN
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum MediaType {
  VIDEO
  IMAGE
}

enum CommandType {
  REFRESH
}

enum CommandStatus {
  PENDING
  COMPLETED
  FAILED
}

/// How a screen shows its featured doctor(s).
enum DoctorMode {
  /// The admin places doctor cards on the timeline by hand.
  MANUAL
  /// A doctor card auto-appears on a fixed interval/duration.
  AUTO
}

/// What a timeline slot holds — uploaded media or a doctor card.
enum PlaylistItemKind {
  MEDIA
  DOCTOR
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  role       Role     @default(OFFICE_ADMIN)
  practiceId String?
  practice   Practice? @relation(fields: [practiceId], references: [id])
  preferredName String?
  mustChangePassword Boolean @default(false)
  onboardedAt   DateTime?
  disabledAt        DateTime?
  sessionsValidFrom DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Practice {
  id        String   @id @default(cuid())
  name      String
  specialty String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  locations Location[]
  devices   Device[]
  media     Media[]
  playlists Playlist[]
  doctors   Doctor[]
}

/// A physician scraped from the practice's public website. Scraped once and cached
/// — screens draw on this saved row, never re-fetching the source site.
model Doctor {
  id                   String   @id @default(cuid())
  practiceId           String
  practice             Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name                 String
  /// Post-nominals as shown on the site, e.g. "MD" or "DO, FACC".
  credentials          String?
  title                String?
  specialty            String?
  /// Headshot copied into our own storage so the screen never hotlinks their site.
  photoUrl             String?
  /// The headshot's URL on the practice's site, so a re-scrape only re-downloads
  /// when they actually changed the image.
  sourcePhotoUrl       String?
  bio                  String?
  /// A short, patient-friendly introduction rephrased for a waiting-room screen at
  /// import time — complete sentences sized to fit the card without truncation.
  screenBlurb          String?
  education            String[]
  boardCertifications  String[]
  languages            String[]
  acceptingNewPatients Boolean?
  /// The page this was scraped from; also the identity used to re-scrape in place.
  sourceUrl            String
  scrapedAt            DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  screens       Device[]       @relation("ScreenDoctors")
  playlistItems PlaylistItem[]

  @@unique([practiceId, sourceUrl])
}

model Location {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])
  name       String
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  devices Device[]
}

model Device {
  id                 String       @id @default(cuid())
  practiceId         String
  practice           Practice     @relation(fields: [practiceId], references: [id])
  locationId         String?
  location           Location?    @relation(fields: [locationId], references: [id])
  name               String
  token              String?      @unique
  roomType           String?
  status             DeviceStatus @default(UNKNOWN)
  lastSeenAt         DateTime?
  softwareVersion    String?
  assignedPlaylistId String?
  assignedPlaylist   Playlist?    @relation(fields: [assignedPlaylistId], references: [id])
  // Featured-doctor settings for this screen (see Stage 2).
  doctorMode            DoctorMode @default(MANUAL)
  doctorIntervalMinutes Int?
  doctorDurationSeconds Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  commands        DeviceCommand[]
  featuredDoctors Doctor[]        @relation("ScreenDoctors")
}

model Media {
  id              String    @id @default(cuid())
  practiceId      String
  practice        Practice  @relation(fields: [practiceId], references: [id])
  title           String
  type            MediaType
  url             String
  durationSeconds Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  playlistItems PlaylistItem[]
}

model Playlist {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items   PlaylistItem[]
  devices Device[]
}

model PlaylistItem {
  id                      String           @id @default(cuid())
  playlistId              String
  playlist                Playlist         @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  kind                    PlaylistItemKind @default(MEDIA)
  // Media-backed items carry a mediaId; doctor cards carry a doctorId instead.
  mediaId                 String?
  media                   Media?           @relation(fields: [mediaId], references: [id])
  doctorId                String?
  doctor                  Doctor?          @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  position                Int
  // True for doctor clips placed automatically by Auto mode (interval scheduling),
  // so toggling a featured doctor off can remove exactly those without touching
  // clips the admin placed by hand.
  autoGenerated           Boolean          @default(false)
  durationOverrideSeconds Int?
  trimStartSeconds        Int?
  trimEndSeconds          Int?
  // Black "dead air" seconds before this clip on the timeline. Lets clips sit
  // apart with a gap (an "island") instead of always packing flush.
  leadingGapSeconds       Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model DeviceCommand {
  id          String        @id @default(cuid())
  deviceId    String
  device      Device        @relation(fields: [deviceId], references: [id])
  commandType CommandType   @default(REFRESH)
  status      CommandStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  completedAt DateTime?
}

// A short-lived pairing request started by a player device. The device shows the
// `code` on its screen; an admin enters it in the panel to bind it to a Screen
// (Device). `secretHash` is the hash of a machine-only secret so only the device
// that started the enrollment can poll for the resulting token.
model PendingEnrollment {
  id         String    @id @default(cuid())
  code       String    @unique
  secretHash String
  deviceName String?
  status     String    @default("PENDING") // PENDING | CLAIMED
  deviceId   String? // the Screen created on claim
  practiceId String? // the practice that claimed it
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  claimedAt  DateTime?
}
